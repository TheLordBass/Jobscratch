# Copy this file to .env.local and fill in what you have.
# Everything is optional except ANTHROPIC_API_KEY (for AI CV tailoring).
# Restart `npm run dev` after changing it.

# --- AI CV tailoring (Claude) ------------------------------------------------
# https://console.anthropic.com/  → API keys
ANTHROPIC_API_KEY=
# Optional: a different Claude model (default claude-opus-5-5).
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: a cheaper model or effort just for match analyses (default: the model
# above, at medium effort), e.g. for long Match all lists. Check a few scores first.
# ANTHROPIC_MATCH_MODEL=claude-haiku-5-5
# ANTHROPIC_MATCH_EFFORT=low
# Optional: turn off automatic retry on another model when a request is declined.
# ANTHROPIC_FALLBACKS=off

# Optional: a GitHub token (no scopes needed) raises GitHub's limit for reading
# your public repositories from 60 to 5,000 requests an hour.
# https://github.com/settings/tokens
# GITHUB_TOKEN=

# --- Job board APIs (free keys) ----------------------------------------------
# Adzuna: UK, US, EU, Australia, India and more. https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Reed: UK only. https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=
# Jooble: 60+ countries. https://jooble.org/api/about
JOOBLE_API_KEY=
# Use your country's Jooble host if your key was issued for it, e.g. uk.jooble.org
# JOOBLE_HOST=jooble.org
# USAJOBS: US federal jobs. https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# --- Google for Jobs (covers LinkedIn, Indeed, Glassdoor listings) -----------
# SerpApi: free monthly allowance. https://serpapi.com/users/sign_up
SERPAPI_API_KEY=
# JSearch on RapidAPI: free tier. https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# --- Protect a deployed copy -------------------------------------------------
# If you put JobScratch on the internet, set a password so strangers can't use
# your API credits or see your data. You sign in with these on a sign-in page.
# APP_USERNAME=you@example.com
# APP_PASSWORD=

# --- Keep your data on the server (optional) ----------------------------------
# Add "Upstash for Redis" from Vercel → Storage; it sets these for you. Needs
# APP_PASSWORD above, or server storage stays off. See README → Your data.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# For local development without Upstash, a JSON file instead:
# JOBSCRATCH_DATA_FILE=./.data/jobscratch.json

# --- The morning JobSpy run (optional) -----------------------------------------
# The token your computer sends with its results (scripts/jobspy/scheduled.py).
# scripts/jobspy/schedule-morning-run.ps1 makes one; put the same value here and
# in scripts/jobspy/.env. At least 24 characters. See README → Every morning.
# JOBSCRATCH_HELPER_TOKEN=

# --- Notifications (optional) -------------------------------------------------
# The morning run's summary on your phone (README → Ready before you're up).
# Make both once with: npx web-push generate-vapid-keys
# JOBSCRATCH_VAPID_PUBLIC_KEY=
# JOBSCRATCH_VAPID_PRIVATE_KEY=
