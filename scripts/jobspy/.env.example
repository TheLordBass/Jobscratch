# For the morning JobSpy run (scheduled.py). schedule-morning-run.ps1 writes scripts/jobspy/.env
# for you; this shows what goes in it. Never commit .env: the token lets this computer add jobs.
JOBSCRATCH_URL=https://jobscratch.vercel.app
# The same long random value as JOBSCRATCH_HELPER_TOKEN in Vercel.
JOBSCRATCH_HELPER_TOKEN=
